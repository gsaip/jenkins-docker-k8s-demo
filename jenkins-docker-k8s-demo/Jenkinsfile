
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'saiprasad18/jenkins-k8s-demo'
        APP_DIR = 'jenkins-docker-k8s-demo'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test Python Application') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -eu
                        python3 -m py_compile app.py
                        python3 -m venv .venv
                        .venv/bin/pip install -r requirements.txt
                        .venv/bin/python -c "import app; print('Flask application imported successfully')"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        set -eu
                        docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu
                        echo "$DOCKER_PASS" | docker login \
                            -u "$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Application tested and Docker image pushed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review the stage logs.'
        }
        always {
            sh 'rm -rf jenkins-docker-k8s-demo/.venv || true'
        }
    }
}
