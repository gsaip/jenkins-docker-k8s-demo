pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'your-dockerhub-username'
        IMAGE_NAME      = 'demo-app'
        IMAGE_TAG       = "${BUILD_NUMBER}"
        KUBECONFIG_ID   = 'k8s-kubeconfig' // Jenkins Credential ID for K8s access
        DOCKER_CREDS_ID = 'dockerhub-credentials' // Jenkins Credential ID for Docker Hub
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/your-username/devops-capstone.git'
            }
        }

        stage('Code Linting / Test') {
            steps {
                echo 'Running tests...'
                // Insert unit test commands here (e.g., pytest)
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker image ${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}..."
                    sh "docker build -t ${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} ./app"
                    sh "docker tag ${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USER')]) {
                        sh "echo $DOCKER_PASSWORD | docker login -u $DOCKER_USER --password-stdin"
                        sh "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_HUB_USER}/${IMAGE_NAME}:latest"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Update deployment manifest dynamically with build tag
                    sh "sed -i 's|BUILD_NUMBER|${IMAGE_TAG}|g' k8s/deployment.yaml"
                    sh "sed -i 's|YOUR_DOCKERHUB_USERNAME|${DOCKER_HUB_USER}|g' k8s/deployment.yaml"

                    // Apply K8s manifests using kubectl
                    sh "kubectl apply -f k8s/configmap.yaml"
                    sh "kubectl apply -f k8s/deployment.yaml"
                    sh "kubectl apply -f k8s/service.yaml"
                    
                    // Verify rollout status
                    sh "kubectl rollout status deployment/demo-app"
                }
            }
        }
    }

    post {
        always {
            // Clean up Docker images locally to save space
            sh "docker rmi ${DOCKER_HUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
        success {
            echo "Deployment successfully executed!"
        }
        failure {
            echo "Pipeline failed. Check build logs for details."
        }
    }
}
