pipeline {
    agent any

    environment {
        IMAGE_NAME      = 'demo-app'
        IMAGE_TAG       = "${BUILD_NUMBER}"
        DOCKER_CREDS_ID = 'dockerhub-creds'
        KUBECONFIG      = '/var/lib/jenkins/.kube/config'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Code Linting / Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USER')]) {
                        echo "Building Docker image ${DOCKER_USER}/${IMAGE_NAME}:${IMAGE_TAG}..."
                        // Updated build context path to devops-capstone/app
                        sh "docker build -t ${DOCKER_USER}/${IMAGE_NAME}:${IMAGE_TAG} ./devops-capstone/app"
                        sh "docker tag ${DOCKER_USER}/${IMAGE_NAME}:${IMAGE_TAG} ${DOCKER_USER}/${IMAGE_NAME}:latest"
                    }
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USER')]) {
                        sh "echo $DOCKER_PASSWORD | docker login -u $DOCKER_USER --password-stdin"
                        sh "docker push ${DOCKER_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_USER}/${IMAGE_NAME}:latest"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USER')]) {
                        // Updated path to point to devops-capstone/k8s/
                        sh "sed -i 's|YOUR_DOCKERHUB_USERNAME|${DOCKER_USER}|g' devops-capstone/k8s/deployment.yaml"
                        sh "sed -i 's|BUILD_NUMBER|${IMAGE_TAG}|g' devops-capstone/k8s/deployment.yaml"

                        sh "kubectl get nodes"
                        sh "kubectl apply -f devops-capstone/k8s/"
                        sh "kubectl rollout status deployment/demo-app"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USER')]) {
                    sh "docker rmi ${DOCKER_USER}/${IMAGE_NAME}:${IMAGE_TAG} || true"
                }
            }
        }
        success {
            echo "Deployment successfully executed!"
        }
        failure {
            echo "Pipeline failed. Check build logs for details."
        }
    }
}
